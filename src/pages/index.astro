---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import CTABand from '../components/CTABand.astro';
import FAQ from '../components/FAQ.astro';
import CheckupBoard from '../components/CheckupBoard.astro';
import Photo from '../components/Photo.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { bookingHref, bookingIsExternal } from '../data/site';
import { originShort } from '../lib/origin';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);

// Each pain leads to the service that fixes it.
const pains = [
  { icon: 'copy', text: 'The same data typed into several systems, or work that stalls between departments', href: '/services/automation-integrations/' },
  { icon: 'users', text: 'Leads and customer updates handled by hand, or AI used where a simple tool would do better', href: '/services/ai-implementation/' },
  { icon: 'gauge', text: 'Paying for several tools, with no clear picture of what’s used or what overlaps', href: '/services/software-cost-review/' },
  { icon: 'code', text: 'A one-off problem no off-the-shelf tool solves', href: '/services/custom-software/' },
  { icon: 'lifebuoy', text: 'A software project, internal tool or website that stalled, was abandoned, or breaks when you touch it', href: '/services/software-rescue/' },
  { icon: 'clipboard', text: 'Numbers you can only see after an hour of exporting and pasting', href: '/services/dashboards-reporting/' },
];

// Figures come from the case studies. Keep them identical to what those pages say.
const proof = [
  { figure: '300+', label: 'open defects on machine-control software, all eventually fixed, with new reports nearly stopping' },
  { figure: '10+ steps → 1', label: 'a weekly spreadsheet routine replaced with a one-screen form' },
  { figure: '−20%', label: 'monthly cloud spend on an e-commerce platform, after a thorough review of every resource' },
];

// The three beats of a Workflow Checkup, under the board.
const checkupSteps = [
  { t: 'Map it together', d: 'In person in Spokane or over a video call. We discuss the process from start to finish.' },
  { t: 'Mark the problems', d: 'Double entry, manual steps, missed follow-ups and tools you pay for twice. Each one gets a time or dollar cost.' },
  { t: 'Get the fix list', d: 'A written report with the suggested fixes, ranked by priority. It’s yours to keep, whether or not you hire me.' },
];

const why = [
  { t: 'Honest scope, clear prices.', d: 'Clear estimates, changes agreed in writing, no surprise invoices.' },
  { t: 'You own it.', d: 'Code, accounts and documentation are handed over. No lock-in.' },
  { t: 'Small, verified steps.', d: 'I fix things in pieces I can check, and I tell you plainly when something isn’t worth fixing.' },
];

const faqs = [
  {
    q: 'What does a typical project cost?',
    a: 'It depends on scope, which is why most projects start with a fixed-price Workflow Checkup, $395, credited toward any project that follows. Larger or more technical work starts with a discovery or assessment quoted for that project. My hourly rate for ad hoc work is $125. Prices exclude any applicable sales tax.',
  },
  {
    q: 'Do you work with businesses outside Spokane?',
    a: 'Yes. Most work is done remotely, with video calls and shared documents. I’m happy to meet in person around Spokane, and I’m open to discussing travel to a customer in certain cases.',
  },
  {
    q: 'Do you work with larger businesses and IT teams?',
    a: 'Yes. I work directly with owners, operations teams and department leads, alongside your IT staff and software vendors when needed.',
  },
  {
    q: 'How do you run a project?',
    a: 'Every project has written deliverables, milestones and sign-off, and any change in scope is agreed in writing first. I quote a fixed price where the scope is clear enough. I’m reachable during normal business hours, and we agree how we’ll communicate at the start.',
  },
  {
    q: 'Who owns the software you build?',
    a: 'You do, once you’ve paid. Code, accounts and documentation are handed over, so another developer can maintain the work. I keep my own reusable tools and grant you a license to use them in your project.',
  },
  {
    q: 'I already pay for software. Can you make it work better instead of replacing it?',
    a: 'Usually, yes. Connecting and configuring what you already have is often the cheapest fix.',
  },
  {
    q: 'What if my last developer disappeared?',
    a: 'That’s exactly what Software Rescue is for. The first step is making sure you have access to your code and accounts.',
  },
  {
    q: 'Can I get support after handoff?',
    a: 'Yes. It’s usually billed at my hourly rate, $125, or quoted for specific fixes and improvements.',
  },
];
---

<BaseLayout
  fullTitle
  title="Oakheart Technologies: Fix Broken Software & Processes"
  headerTone="dark"
  description="I fix broken software and manual processes for small and mid-size businesses: rescue, automation, dashboards, cost reviews and custom software. Spokane, WA and remote."
>
  <!-- 1. Hero: "workshop at night" -->
  <section class="on-dark night night-glow relative overflow-hidden">
    <div class="wrap relative z-[1] pt-12 pb-16 md:pt-16 md:pb-24">
      <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-14">
        <div>
          <p class="eyebrow [text-wrap:balance]">Software fixes, automation and custom builds</p>
          <h1 class="mt-4 max-w-4xl text-[2.5rem] leading-[1.04] text-white md:text-6xl lg:text-[4.25rem]">
            Fixed so it stays fixed. Built to <em class="font-normal whitespace-nowrap text-brass">save you time.</em>
          </h1>
          <p class="prose-measure mt-6 text-xl text-[#b8c1d4]">
            Failing software, manual processes and reports built by hand. I find the real problem, then fix it or build
            what's missing.
          </p>
          <p class="mt-3 text-sm font-medium text-[#97a2b9]">Based in Spokane, WA. Working locally and remotely.</p>
          <div class="mt-9 flex flex-wrap gap-4">
            <Button href={bookingHref} external={bookingIsExternal} variant="brass">Book a free 30-minute call</Button>
            <Button href="/work/" variant="outline-light">See the results</Button>
          </div>
        </div>
        <div class="tablet">
          <div class="screen">
            <div class="vp">
              <iframe
                src="/console/"
                title="Animated example: one job moves from request to paid, a failed sync is caught and fixed with the owner’s approval, and the time to invoice drops"
                loading="lazy"
                tabindex="-1"></iframe>
            </div>
          </div>
          <p class="mt-5 text-center text-[0.8rem] text-[#7f8aa3]">
            A problem caught and fixed along the way, and the result on the owner's dashboard.
          </p>
        </div>
      </div>
      <dl class="mt-16 grid gap-6 border-t border-[#23304d] pt-8 sm:grid-cols-3 md:mt-20">
        {
          proof.map((p) => (
            <div class="sm:border-l sm:border-[#23304d] sm:pl-7 sm:first:border-0 sm:first:pl-0">
              <dt class="font-serif text-4xl font-semibold text-white md:text-5xl">{p.figure}</dt>
              <dd class="mt-2 max-w-[24em] text-sm leading-relaxed text-[#97a2b9]">{p.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 2. Blueprint: the Workflow Checkup -->
  <section id="checkup" class="on-dark blueprint scroll-mt-20">
    <div class="wrap relative py-16 md:py-24">
      <p class="bp-label">// start here · workflow checkup</p>
      <h2 class="mt-3 max-w-[18em] text-3xl leading-[1.08] text-white md:text-5xl">
        Here's how I evaluate a{' '}
        <span class="mark" data-draw>process.<svg viewBox="0 0 300 30" preserveAspectRatio="none" aria-hidden="true"><path d="M4 20 C 60 8, 140 26, 200 14 S 280 10, 296 18"></path></svg></span>
      </h2>
      <p class="mt-4 max-w-[38em] text-lg leading-relaxed text-[#aab6cc]">
        During the working session, we evaluate a workflow. I map it like this, mark where the time and money go in red, and write up
        the fixes worth making first in green.
      </p>
      <div class="mt-9">
        <CheckupBoard />
      </div>

      <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1fr_0.95fr] lg:items-start">
        {
          checkupSteps.map((s, i) => (
            <div class="border-t-[1.5px] border-dashed border-[#4a5b85] pt-4">
              <p class="font-hand text-3xl leading-none text-brass">0{i + 1}</p>
              <h3 class="mt-3 text-xl text-white">{s.t}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-[#aab6cc]">{s.d}</p>
            </div>
          ))
        }
        <figure class="report relative mx-auto w-full max-w-[22rem] sm:col-span-2 lg:col-span-1 lg:-mt-8">
          <span class="tape" aria-hidden="true"></span>
          <Photo
            name="/images/office/checkup-report-printed"
            alt="The printed Workflow Checkup report and action plan for a sample business, lying on a wooden desk"
            widths={[500, 800, 1600]}
            width={1600}
            height={1714}
            sizes="(min-width: 1024px) 22rem, 90vw"
            class="aspect-[4/4.3] w-full bg-[#f4f1ea] object-cover p-2.5 pb-11 shadow-[0_24px_50px_-20px_#000]"
          />
          <figcaption class="font-hand absolute right-0 bottom-2 left-0 text-center text-lg text-ink">what you walk away with</figcaption>
        </figure>
      </div>

      <div class="mt-14 flex flex-col items-start gap-5 rounded-2xl border border-[#2c3a5e] bg-[#0b1324]/70 px-6 py-6 md:px-7">
        <div>
          <p class="font-serif text-2xl font-semibold text-white">Workflow Checkup · $395</p>
          <p class="mt-1 text-[0.95rem] text-[#aab6cc]">Pick the focus: a workflow, software costs, where AI fits, or reporting. Credited in full toward any project that comes out of it.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button href={bookingHref} external={bookingIsExternal} variant="brass">Book a free 30-minute call</Button>
          <Button href="/services/workflow-checkup/" variant="outline-light">See what's included</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What's broken -->
  <section class="bg-white">
    <div class="wrap section">
      <p class="eyebrow">What's broken?</p>
      <h2 class="mt-3 max-w-2xl text-3xl md:text-4xl">The problems I'm usually called in to fix.</h2>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          pains.map((p) => (
            <li class="reveal">
              <a
                href={p.href}
                class="group flex h-full items-start gap-4 rounded-xl border border-line bg-paper p-5 transition-colors hover:border-royal"
              >
                <span class="text-royal">
                  <Icon name={p.icon} />
                </span>
                <span>
                  <span class="block font-medium text-ink">{p.text}</span>
                  <span class="mt-2 flex items-center gap-1 text-sm font-semibold text-royal group-hover:gap-2">
                    See how I fix this <Icon name="arrow" class="h-4 w-4" />
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-8">
        <a href="/services/" class="inline-flex min-h-11 items-center font-semibold text-royal underline underline-offset-4"
          >See all services</a
        >
      </p>
    </div>
  </section>

  <!-- 4. Featured work -->
  {
    work.length > 0 && (
      <section>
        <div class="wrap section">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="eyebrow">Featured work</p>
              <h2 class="mt-3 text-3xl md:text-4xl">Problem, fix, result.</h2>
            </div>
            <a href="/work/" class="inline-flex min-h-11 items-center font-semibold text-royal underline underline-offset-4">All work</a>
          </div>
          <div class="mt-10">
            <p class="font-semibold text-ink">
              One example: a weekly routine cut from 10+ steps to one screen.
              <a href="/work/credit-union-workflows/" class="ml-1 text-royal underline underline-offset-4">Read the story</a>
            </p>
            <BeforeAfter />
          </div>
          <div class="grid gap-6 md:grid-cols-3">
            {work.map((w) => (
              <a href={`/work/${w.id}/`} class="card reveal block p-6 transition-shadow hover:shadow-lg">
                {w.data.draft && <span class="ph text-xs font-semibold">DRAFT PLACEHOLDER</span>}
                <p class="eyebrow mt-3">{originShort[w.data.origin]} · {w.data.service}</p>
                <h3 class="mt-2 text-xl">{w.data.title}</h3>
                <p class="mt-2 text-muted">{w.data.summary}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 5. Founder and trust -->
  <section class="bg-white">
    <div class="wrap section grid gap-10 md:grid-cols-[auto_1fr] md:gap-14">
      <figure class="mx-auto w-full max-w-[14rem] md:mx-0">
        <Photo
          name="/images/office/tyler-at-desk-coding"
          alt="Tyler Latimer at his desk, working across two monitors"
          widths={[400, 640, 1280]}
          width={1280}
          height={1828}
          sizes="14rem"
          class="aspect-[4/5] w-full rounded-2xl border border-line object-cover shadow-sm"
        />
        <figcaption class="mt-3 text-sm text-muted">Tyler Latimer, founder</figcaption>
      </figure>
      <div>
        <p class="eyebrow">Who you'd work with</p>
        <h2 class="mt-3 max-w-2xl text-3xl md:text-4xl">Software engineer. Small business owner.</h2>
        <div class="prose-measure mt-4 space-y-3 text-lg text-muted">
          <p>I'm Tyler, a software engineer with more than eight years of experience building, fixing and improving software.</p>
          <p>I also own a contracting company, so I've felt firsthand how much time a business loses to clumsy tools and manual work.</p>
          <p>Oakheart brings those two sides together: engineering skill, and an owner's sense of what actually matters.</p>
        </div>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {
            why.map((w) => (
              <div class="reveal border-t-2 border-oak pt-5">
                <h3 class="text-xl">{w.t}</h3>
                <p class="mt-2 text-muted">{w.d}</p>
              </div>
            ))
          }
        </div>
        <p class="mt-8"><a href="/about/" class="font-semibold text-royal underline underline-offset-4">More about me</a></p>
      </div>
    </div>
  </section>

  <!-- 6. Games and VR strip (secondary) -->
  <section class="on-dark night">
    <div class="wrap flex flex-col gap-6 py-14 md:flex-row md:items-center md:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow">Beyond business software</p>
        <h2 class="mt-3 text-2xl text-paper md:text-3xl">Interactive training and simulation.</h2>
        <p class="mt-3 text-paper/80">
          I also build interactive and VR training, including a multiplayer simulator for fire departments. I've released
          a VR title on the Meta Quest store, and I'm developing more games.
        </p>
      </div>
      <div class="flex flex-wrap gap-4">
        <Button href="/services/interactive-vr/" variant="light">Interactive & VR training</Button>
        <Button href="/interactive/" variant="outline-light">Games &amp; VR</Button>
      </div>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section>
    <div class="wrap section">
      <p class="eyebrow">FAQ</p>
      <h2 class="mt-3 text-3xl md:text-4xl">Common questions</h2>
      <div class="mt-8 max-w-4xl">
        <FAQ items={faqs} />
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>

<style>
  /* The report photo, taped to the board at a slight angle. */
  .report {
    transform: rotate(-2.2deg);
  }
  .tape {
    position: absolute;
    top: -12px;
    left: 50%;
    width: 110px;
    height: 28px;
    background: rgb(201 164 100 / 0.5);
    transform: translateX(-50%) rotate(4deg);
    z-index: 1;
  }
  /* The "tablet": a tilted screen that straightens a little on hover. The console page scales itself to fit. */
  .tablet {
    perspective: 1600px;
  }
  .screen {
    border-radius: 22px;
    background: #05080f;
    padding: 14px;
    border: 1px solid #2a3552;
    box-shadow:
      0 40px 80px -30px rgb(0 0 0 / 0.8),
      inset 0 0 0 1px rgb(255 255 255 / 0.03);
    transform: rotateY(-9deg) rotateX(3deg);
    transform-origin: left center;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tablet:hover .screen {
    transform: rotateY(-3deg) rotateX(1deg);
  }
  .vp {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px;
    background: #0b1529;
  }
  @media (max-width: 639px) {
    .vp {
      aspect-ratio: 4 / 5;
    }
  }
  .vp iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
  }
  @media (max-width: 1023px) {
    .screen,
    .tablet:hover .screen {
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .screen {
      transition: none;
    }
  }
</style>
