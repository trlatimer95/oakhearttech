---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
// Hashed URLs of the Latin font files, so they can be preloaded (the headline is the largest paint).
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  fullTitle?: boolean;
  noindex?: boolean;
}
const { title, description, fullTitle = false, noindex = false } = Astro.props;
const pageTitle = fullTitle ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#business`,
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  description:
    'Software consultancy for small businesses: software rescue, process automation, software and cloud cost reviews, practical AI implementation and custom software.',
  logo: new URL('/images/logo.png', site.url).toString(),
  image: new URL('/og-image.png', site.url).toString(),
  knowsAbout: ['Software rescue', 'Process automation', 'Software cost reduction', 'C# and .NET', 'Azure', 'Unity and VR'],
  email: site.email,
  telephone: site.phone ? `+1${site.phone.replace(/\D/g, '')}` : undefined,
  founder: { '@type': 'Person', name: 'Tyler Latimer', sameAs: [site.linkedinFounder] },
  areaServed: [
    { '@type': 'City', name: 'Spokane', containedInPlace: { '@type': 'State', name: 'Washington' } },
    { '@type': 'Country', name: 'United States' },
  ],
  address: { '@type': 'PostalAddress', addressLocality: 'Spokane', addressRegion: 'WA', addressCountry: 'US' },
  sameAs: [site.linkedin, site.github, site.facebook].filter(Boolean),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#152D5C" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.png', site.url).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Oakheart Technologies: Careful engineering. Efficient processes. Problems solved at the source." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og-image.png', site.url).toString()} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {
      site.analyticsToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: site.analyticsToken })}
        />
      )
    }
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-royal focus:px-4 focus:py-2 focus:text-white"
      >Skip to content</a
    >
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }),
          { threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
