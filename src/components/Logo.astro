---
// Real logo files live in public/images (generated from the supplied artwork).
// "lockup" = full wordmark with the oak "O". "emblem" = the oak "O" on its own.
// tone "light" is for dark backgrounds.
interface Props {
  variant?: 'lockup' | 'emblem';
  tone?: 'color' | 'light';
  class?: string;
}
const { variant = 'lockup', tone = 'color', class: cls = '' } = Astro.props;

const sources = {
  lockup: { color: '/images/logo.webp', light: '/images/logo-light.webp', w: 400, h: 130 },
  emblem: { color: '/images/icon.webp', light: '/images/icon-light.webp', w: 72, h: 80 },
};
const s = sources[variant];
const src = tone === 'light' ? s.light : s.color;
const size = variant === 'lockup' ? 'h-12 w-auto md:h-[3.25rem]' : 'h-10 w-auto';
---

<img
  src={src}
  width={s.w}
  height={s.h}
  alt="Oakheart Technologies"
  class:list={[size, cls]}
  decoding="async"
/>
