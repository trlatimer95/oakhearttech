---
// The hand-drawn "Monday report" board from the Workflow Checkup, drawn in as it scrolls into view.
// Sample business; the figures are made up. Phones get a stacked version of the same board.
interface Props {
  label?: string;
}
const { label = 'An example checkup board ↓' } = Astro.props;
const summary =
  'Hand-drawn flow of a weekly report made by hand: export from three systems, paste into a master spreadsheet, fix the formulas, send a PDF, decide at the 9 am Monday meeting. Three problems are marked, with their fixes underneath: systems sync nightly, no formulas to fix with checks built in, and a live dashboard that emails itself Monday at 7 am. About 3 hours a week back';

const stack = [
  { t: 'Export', s: '3 systems, by hand' },
  { t: 'Paste in', s: 'master spreadsheet', leak: 'copy-paste, 3 exports', fix: 'systems sync nightly, no exports' },
  { t: 'Fix it up', s: 'formulas, totals', leak: 'formulas break weekly', fix: 'no formulas to fix, checks built in' },
  { t: 'Send it', s: 'PDF to the team', leak: 'out of date by Tuesday', fix: 'live dashboard, emails Mon 7 am' },
  { t: 'Decide', s: 'Mon 9 am', end: true },
];
const box = (y: number) => `M20 ${y + 8} q0 -8 8 -8 l304 1 q8 0 8 8 l-1 54 q0 8 -8 8 l-304 -1 q-8 0 -8 -8 z`;
let cursor = 10;
const rows = stack.map((row, i) => {
  const y = cursor;
  cursor += row.leak ? 160 : 104;
  return { ...row, y, d: i * 0.7, n: stack.slice(0, i).filter((s) => s.leak).length + 1 };
});
---

<div data-board>
  <div class="tools">
    <span class="note">{label}</span>
    <button type="button" class="pill" data-replay>↻ replay</button>
  </div>
  <div class="board">
    <svg
      class="drawn wide"
      viewBox="0 0 1200 430"
      role="img"
      aria-label={summary}
    >
      <defs>
        <marker id="board-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M0 0 L10 5 L0 10" fill="none" stroke-width="1.8"></path>
        </marker>
      </defs>
      <!-- boxes -->
      <g>
        <path class="ln" style="--d:0s;--l:560" d="M40 150 q-4 -42 6 -46 l150 -2 q8 2 8 10 l2 80 q-2 8 -10 8 l-148 2 q-8 -4 -8 -12 z"></path>
        <text class="fade fk" style="--d:.5s" x="122" y="148" text-anchor="middle" font-size="26" font-weight="700">Export</text>
        <text class="fade fk2" style="--d:.6s" x="122" y="176" text-anchor="middle" font-size="18">3 systems, by hand</text>
        <path class="ln" style="--d:.5s;--l:120" d="M210 150 C 240 148, 262 152, 292 150" marker-end="url(#board-arrow)"></path>
        <path class="ln" style="--d:.6s;--l:560" d="M300 150 q-2 -44 8 -46 l150 0 q8 2 8 10 l0 80 q-2 8 -10 8 l-148 0 q-8 -2 -8 -10 z"></path>
        <text class="fade fk" style="--d:1.1s" x="384" y="148" text-anchor="middle" font-size="26" font-weight="700">Paste in</text>
        <text class="fade fk2" style="--d:1.2s" x="384" y="176" text-anchor="middle" font-size="18">master spreadsheet</text>
        <path class="ln" style="--d:1.1s;--l:120" d="M472 150 C 502 152, 524 148, 554 150" marker-end="url(#board-arrow)"></path>
        <path class="ln" style="--d:1.2s;--l:560" d="M562 150 q0 -44 8 -46 l150 2 q8 0 8 8 l0 82 q0 8 -10 8 l-148 -2 q-8 0 -8 -10 z"></path>
        <text class="fade fk" style="--d:1.7s" x="646" y="148" text-anchor="middle" font-size="26" font-weight="700">Fix it up</text>
        <text class="fade fk2" style="--d:1.8s" x="646" y="176" text-anchor="middle" font-size="18">formulas, totals</text>
        <path class="ln" style="--d:1.7s;--l:120" d="M734 150 C 764 148, 786 152, 816 150" marker-end="url(#board-arrow)"></path>
        <path class="ln" style="--d:1.8s;--l:560" d="M824 150 q-2 -42 8 -46 l150 0 q8 2 8 10 l0 80 q0 8 -10 8 l-148 0 q-8 0 -8 -10 z"></path>
        <text class="fade fk" style="--d:2.3s" x="908" y="148" text-anchor="middle" font-size="26" font-weight="700">Send it</text>
        <text class="fade fk2" style="--d:2.4s" x="908" y="176" text-anchor="middle" font-size="18">PDF to the team</text>
        <path class="ln" style="--d:2.3s;--l:120" d="M996 150 C 1026 152, 1048 148, 1074 150" marker-end="url(#board-arrow)"></path>
        <path class="ln" style="--d:2.4s;--l:440" d="M1082 150 q0 -40 8 -42 l90 0 q8 2 8 10 l0 76 q0 8 -10 8 l-88 0 q-8 0 -8 -10 z"></path>
        <text class="fade fg" style="--d:2.9s" x="1136" y="146" text-anchor="middle" font-size="24" font-weight="700">Decide</text>
        <text class="fade fk2" style="--d:3s" x="1136" y="174" text-anchor="middle" font-size="18">Mon 9 am</text>
      </g>
      <!-- problems -->
      <g>
        <circle class="ln cr" style="--d:3.2s;--l:120" cx="384" cy="70" r="17"></circle>
        <text class="fade fr" style="--d:3.4s" x="384" y="78" text-anchor="middle" font-size="22" font-weight="700">1</text>
        <text class="fade fr" style="--d:3.5s" x="410" y="58" font-size="21">copy-paste, 3 exports</text>
        <circle class="ln cr" style="--d:3.6s;--l:120" cx="646" cy="70" r="17"></circle>
        <text class="fade fr" style="--d:3.8s" x="646" y="78" text-anchor="middle" font-size="22" font-weight="700">2</text>
        <text class="fade fr" style="--d:3.9s" x="672" y="58" font-size="21">formulas break weekly</text>
        <circle class="ln cr" style="--d:4s;--l:120" cx="908" cy="70" r="17"></circle>
        <text class="fade fr" style="--d:4.2s" x="908" y="78" text-anchor="middle" font-size="22" font-weight="700">3</text>
        <text class="fade fr" style="--d:4.3s" x="934" y="58" font-size="21">out of date by Tuesday</text>
      </g>
      <!-- fixes -->
      <g>
        <path class="ln cg thin" style="--d:4.8s;--l:2400" d="M40 270 l1150 0"></path>
        <text class="fade fg" style="--d:5s" x="40" y="258" font-size="22" font-weight="700">Fix first ↓</text>
        <path class="ln cg" style="--d:5.1s;--l:200" d="M384 204 C 380 230, 388 250, 384 300" marker-end="url(#board-arrow)"></path>
        <text class="fade fg" style="--d:5.4s" x="384" y="332" text-anchor="middle" font-size="22">systems sync nightly,</text>
        <text class="fade fg" style="--d:5.5s" x="384" y="360" text-anchor="middle" font-size="22">no exports</text>
        <path class="ln cg" style="--d:5.6s;--l:200" d="M646 204 C 650 230, 642 250, 646 300" marker-end="url(#board-arrow)"></path>
        <text class="fade fg" style="--d:5.9s" x="646" y="332" text-anchor="middle" font-size="22">no formulas to fix,</text>
        <text class="fade fg" style="--d:6s" x="646" y="360" text-anchor="middle" font-size="22">checks built in</text>
        <path class="ln cg" style="--d:6.1s;--l:200" d="M908 204 C 904 230, 912 250, 908 300" marker-end="url(#board-arrow)"></path>
        <text class="fade fg" style="--d:6.4s" x="908" y="332" text-anchor="middle" font-size="22">live dashboard,</text>
        <text class="fade fg" style="--d:6.5s" x="908" y="360" text-anchor="middle" font-size="22">emails Mon 7 am</text>
        <path class="ln cr thick" style="--d:6.9s;--l:420" d="M1026 326 C 1052 292, 1186 294, 1190 346 C 1194 404, 1042 410, 1026 364 C 1020 346, 1024 336, 1034 326"></path>
        <text class="fade fk" style="--d:7.2s" x="1108" y="350" text-anchor="middle" font-size="26" font-weight="700">≈ 3 hrs</text>
        <text class="fade fk" style="--d:7.3s" x="1108" y="376" text-anchor="middle" font-size="18">a week back</text>
      </g>
    </svg>
    <svg class="drawn tall" viewBox={`0 0 360 ${cursor + 130}`} role="img" aria-label={summary}>
      <defs>
        <marker id="board-arrow-tall" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M0 0 L10 5 L0 10" fill="none" stroke-width="1.8"></path>
        </marker>
      </defs>
      {
        rows.map((r) => (
          <g>
            <path class="ln" style={`--d:${r.d}s;--l:760`} d={box(r.y)} />
            <text class:list={['fade', r.end ? 'fg' : 'fk']} style={`--d:${r.d + 0.3}s`} x="36" y={r.y + 42} font-size="24" font-weight="700">{r.t}</text>
            <text class="fade fk2" style={`--d:${r.d + 0.3}s`} x="324" y={r.y + 42} text-anchor="end" font-size="17">{r.s}</text>
            {r.leak && (
              <>
                <circle class="ln cr" style={`--d:${r.d + 0.4}s;--l:80`} cx="34" cy={r.y + 92} r="11" />
                <text class="fade fr" style={`--d:${r.d + 0.5}s`} x="34" y={r.y + 98} text-anchor="middle" font-size="16" font-weight="700">{r.n}</text>
                <text class="fade fr" style={`--d:${r.d + 0.5}s`} x="54" y={r.y + 98} font-size="18">{r.leak}</text>
                <text class="fade fg" style={`--d:${r.d + 0.6}s`} x="24" y={r.y + 128} font-size="17">→ {r.fix}</text>
              </>
            )}
            {!r.end && (
              <path class="ln" style={`--d:${r.d + 0.5}s;--l:120`} d={`M340 ${r.y + 72} V${r.y + (r.leak ? 156 : 100)}`} marker-end="url(#board-arrow-tall)" />
            )}
          </g>
        ))
      }
      <path class="ln cr thick" style={`--d:${rows.length * 0.7}s;--l:420`} d={`M112 ${cursor + 18} C 138 ${cursor - 8}, 258 ${cursor - 8}, 262 ${cursor + 40} C 266 ${cursor + 96}, 114 ${cursor + 104}, 100 ${cursor + 56} C 96 ${cursor + 40}, 100 ${cursor + 28}, 112 ${cursor + 18}`} />
      <text class="fade fk" style={`--d:${rows.length * 0.7 + 0.3}s`} x="180" y={cursor + 44} text-anchor="middle" font-size="26" font-weight="700">≈ 3 hrs</text>
      <text class="fade fk" style={`--d:${rows.length * 0.7 + 0.4}s`} x="180" y={cursor + 70} text-anchor="middle" font-size="18">a week back</text>
    </svg>
  </div>
</div>

<script>
  // Draw each board (and any element marked data-draw) the first time it scrolls into view.
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('go');
          io.unobserve(e.target);
        }
      }),
    { threshold: 0.35 },
  );
  document.querySelectorAll('[data-board] .drawn, [data-draw]').forEach((el) => io.observe(el));

  document.querySelectorAll<HTMLElement>('[data-board]').forEach((root) => {
    root.querySelector('[data-replay]')?.addEventListener('click', () => {
      root.querySelectorAll('.drawn').forEach((drawn) => {
        drawn.classList.remove('go');
        void drawn.getBoundingClientRect();
        drawn.classList.add('go');
      });
    });
  });
</script>

<style>
  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.875rem;
  }
  .note {
    font-family: var(--font-hand);
    font-size: 1.25rem;
    color: #e8dcc3;
    margin-right: auto;
  }
  .pill {
    font-family: var(--font-hand);
    font-size: 1.1875rem;
    line-height: 1.3;
    color: #e8dcc3;
    background: transparent;
    border: 1.5px solid #4a5b85;
    border-radius: 999px;
    padding: 0.35rem 0.95rem;
    min-height: 2.75rem;
    cursor: pointer;
  }
  .board {
    --k: #0e1a33;
    --k2: #5b616e;
    --r: #b3261e;
    --g: #2f6b3a;
    border-radius: 0.5rem;
    padding: 0.625rem;
    background: #fbfaf6;
    border: 1px solid #d9dde6;
    box-shadow: 0 30px 60px -30px #000;
    background-image:
      linear-gradient(rgb(21 45 92 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(21 45 92 / 0.06) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .board svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .board text {
    font-family: var(--font-hand);
  }
  .board .tall {
    display: none;
  }
  .ln {
    fill: none;
    stroke: var(--k);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cr {
    stroke: var(--r);
  }
  .cg {
    stroke: var(--g);
  }
  .thin {
    stroke-width: 2.2;
  }
  .thick {
    stroke-width: 3;
  }
  .fk {
    fill: var(--k);
  }
  .fk2 {
    fill: var(--k2);
  }
  .fr {
    fill: var(--r);
  }
  .fg {
    fill: var(--g);
  }
  marker path {
    stroke: var(--k);
  }
  /* Lines are hidden behind their own dash offset until .go lands, then "drawn" in, in order. */
  .drawn .ln {
    stroke-dasharray: var(--l, 900);
    stroke-dashoffset: var(--l, 900);
  }
  .drawn.go .ln {
    animation: draw 1s ease-out forwards;
    animation-delay: var(--d, 0s);
  }
  .fade {
    opacity: 0;
  }
  .drawn.go .fade {
    animation: fin 0.5s ease-out forwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fin {
    to {
      opacity: 1;
    }
  }
  @media (max-width: 920px) {
    .board .wide {
      display: none;
    }
    .board .tall {
      display: block;
      max-width: 26rem;
      margin-inline: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .drawn .ln,
    .drawn.go .ln {
      animation: none;
      stroke-dashoffset: 0;
    }
    .fade,
    .drawn.go .fade {
      animation: none;
      opacity: 1;
    }
  }
</style>
