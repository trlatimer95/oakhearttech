---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import CTABand from '../../components/CTABand.astro';
import FAQ from '../../components/FAQ.astro';
import { services, type Service } from '../../data/services';
import { bookingHref, bookingIsExternal } from '../../data/site';
import { ph } from '../../lib/ph';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const service = Astro.props.s as Service;
---

<BaseLayout title={service.title} description={service.metaDescription}>
  <!-- 1. Hero -->
  <section class="wrap section">
    <a href="/services" class="text-sm font-semibold text-royal underline underline-offset-4">← All services</a>
    <p class="eyebrow mt-6">{service.title}{service.badge ? ` · ${service.badge}` : ''}</p>
    <h1 class="mt-3 max-w-4xl text-4xl md:text-6xl">{service.heroTitle}</h1>
    <p class="prose-measure mt-6 text-xl text-muted">{service.heroLead}</p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button href={bookingHref} external={bookingIsExternal}>Book a free 30-minute call</Button>
      <span class="font-semibold text-ink" set:html={ph(service.price)} />
    </div>
  </section>

  <!-- 2. Signs -->
  <section class="bg-white">
    <div class="wrap section">
      <h2 class="text-3xl md:text-4xl">{service.signsTitle}</h2>
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {
          service.signs.map((t) => (
            <li class="flex gap-3 rounded-xl border border-line bg-paper p-5">
              <span class="mt-0.5 text-oak">
                <Icon name="check" />
              </span>
              <span>{t}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. Included -->
  <section>
    <div class="wrap section grid gap-10 md:grid-cols-[1fr_1fr]">
      <div>
        <h2 class="text-3xl md:text-4xl">{service.includesTitle}</h2>
        <ul class="mt-8 space-y-4">
          {
            service.includes.map((t) => (
              <li class="flex gap-3">
                <span class="mt-0.5 text-royal">
                  <Icon name="check" />
                </span>
                <span>{t}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <aside class="card self-start p-7">
        <p class="eyebrow">Price</p>
        <p class="mt-2 font-serif text-3xl font-semibold text-ink" set:html={ph(service.price)} />
        <p class="mt-3 text-muted" set:html={ph(service.priceNote)} />
        <Button href={bookingHref} external={bookingIsExternal} class="mt-6 w-full">Book a free call</Button>
      </aside>
    </div>
  </section>

  <!-- 4. Process -->
  <section class="bg-white">
    <div class="wrap section">
      <h2 class="text-3xl md:text-4xl">{service.processTitle}</h2>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-[repeat(auto-fit,minmax(11rem,1fr))]">
        {
          service.process.map((p, i) => (
            <li class="border-t-2 border-oak pt-4">
              <span class="font-serif text-3xl font-semibold text-oak">{i + 1}</span>
              <h3 class="mt-1 text-xl">{p.title}</h3>
              <p class="mt-2 text-muted" set:html={ph(p.text)} />
            </li>
          ))
        }
      </ol>
      {
        service.stance && (
          <p class="mt-10 border-l-4 border-brass bg-paper p-5 font-serif text-xl text-ink">{service.stance}</p>
        )
      }
    </div>
  </section>

  <!-- 5. FAQ -->
  <section>
    <div class="wrap section">
      <h2 class="text-3xl md:text-4xl">Questions</h2>
      <div class="mt-8 max-w-3xl">
        <FAQ items={service.faqs} />
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="wrap flex flex-col gap-3 py-10 md:flex-row md:items-center md:justify-between">
      <p class="text-lg text-ink">
        <span class="font-serif font-semibold">Keep it fixed.</span>
        <span class="text-muted"> Ongoing care plans from $375 a month cover monitoring, fixes and small changes.</span>
      </p>
      <a href="/care-plan" class="font-semibold text-royal underline underline-offset-4">See care plans</a>
    </div>
  </section>

  <CTABand />
</BaseLayout>
