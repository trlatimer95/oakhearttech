---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import CTABand from '../../components/CTABand.astro';
import { services } from '../../data/services';
import { ph } from '../../lib/ph';
---

<BaseLayout
  title="Software Services for Small Business"
  description="Workflow checkups, automation and integrations, custom software and websites, software rescue, and interactive/VR training for small businesses."
>
  <section class="wrap section">
    <p class="eyebrow">Services</p>
    <h1 class="mt-3 max-w-3xl text-4xl md:text-6xl">Practical help, in the order that makes sense.</h1>
    <p class="prose-measure mt-6 text-xl text-muted">
      Not sure where to start? Start with the Workflow Checkup. It's a fixed-price way to find out what's worth fixing
      before spending on a bigger project. The other entry offers (the software cost review, the AI checkup and the
      rescue assessment) are focused versions of the same idea.
    </p>

    <div class="mt-12 grid gap-6">
      {
        services.map((s) => (
          <a
            href={`/services/${s.slug}/`}
            class="card group grid gap-4 p-7 transition-shadow hover:shadow-lg md:grid-cols-[auto_1fr_auto] md:items-center md:gap-8"
          >
            <span class="text-royal">
              <Icon name={s.icon} class="h-9 w-9" />
            </span>
            <div>
              <h2 class="text-2xl">
                {s.title}
                {s.badge && (
                  <span class="ml-2 rounded-full bg-royal px-3 py-1 align-middle font-sans text-xs font-semibold text-white">
                    {s.badge}
                  </span>
                )}
              </h2>
              <p class="mt-1 text-muted">{s.summary}</p>
            </div>
            <p class="font-semibold text-ink md:text-right" set:html={ph(s.price)} />
          </a>
        ))
      }
    </div>
  </section>
  <CTABand />
</BaseLayout>
