---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABand from '../../components/CTABand.astro';
import { originShort } from '../../lib/origin';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Case Studies: Problem, Fix, Result"
  description="Case studies from Oakheart Technologies: the problem, the fix and the result, from software rescue to automation and cost reduction."
>
  <section class="wrap section">
    <p class="eyebrow">Work</p>
    <h1 class="mt-3 max-w-3xl text-4xl md:text-6xl">Problem, fix, result.</h1>
    <p class="prose-measure mt-6 text-xl text-muted">Real projects, described in plain language.</p>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        work.map((w) => (
          <a href={`/work/${w.id}/`} class="card block p-7 transition-shadow hover:shadow-lg">
            {w.data.draft && <span class="ph text-xs font-semibold">DRAFT PLACEHOLDER</span>}
            <p class="eyebrow mt-3">{originShort[w.data.origin]} · {w.data.client}</p>
            <h2 class="mt-2 text-2xl">{w.data.title}</h2>
            <p class="mt-2 text-muted">{w.data.summary}</p>
          </a>
        ))
      }
    </div>
  </section>
  <CTABand />
</BaseLayout>
