---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import CTABand from '../../components/CTABand.astro';
import PageHero from '../../components/PageHero.astro';
import FAQ from '../../components/FAQ.astro';
import { services } from '../../data/services';
import { ph } from '../../lib/ph';

const costs = [
  { t: 'Workflow Checkup', d: '$395, fixed, with the focus you choose: a workflow, software costs, where AI fits, or reporting. Credited toward any project that follows.' },
  {
    t: 'Automation',
    d: 'A single, simple automation can cost a few hundred dollars. Connecting a whole process costs more, and a large set of connected automations can run well into five figures.',
  },
  {
    t: 'Dashboards and reporting',
    d: 'Priced by how many sources the dashboard draws from and how clean they are. One tidy source is a modest project; several sources or custom views cost more.',
  },
  {
    t: 'Custom software',
    d: 'Priced by size. A small tool costs a fraction of a full platform build, which can run into six figures.',
  },
  { t: 'Software rescue', d: 'The assessment is quoted per project. Fixes are quoted after it.' },
  { t: 'Ad hoc work', d: '$125 an hour.' },
];

const faqs = [
  {
    q: 'Do you charge sales tax?',
    a: 'It depends on the state and the service. Where tax applies, it’s itemized on every quote, and I’ll confirm what applies before you commit.',
  },
];
---

<BaseLayout
  title="Software Services for Small Business"
  description="Workflow checkups, automation and integrations, custom software and websites, software rescue, and interactive/VR training for small businesses."
>
  <PageHero>
    <p class="eyebrow">Services</p>
    <h1 class="mt-3 max-w-3xl text-4xl text-white md:text-6xl">Practical help, in the order that makes sense.</h1>
    <p class="prose-measure mt-6 text-xl text-[#b8c1d4]">
      Every project starts with the Workflow Checkup: one fixed price, and you pick the focus. It's the way to find out
      what's worth fixing before spending on a bigger project. I work with businesses from a crew of three to a few
      hundred people. Software rescue is the exception: it starts with a code assessment quoted per project, since a
      small web app and a large platform are very different jobs.
    </p>
  </PageHero>

  <section class="wrap section">
    <div class="grid gap-6">
      {
        services.map((s) => (
          <a
            href={`/services/${s.slug}/`}
            class="card group grid gap-4 p-7 transition-shadow hover:shadow-lg md:grid-cols-[auto_1fr_auto] md:items-center md:gap-8"
          >
            <span class="text-royal">
              <Icon name={s.icon} class="h-9 w-9" />
            </span>
            <div>
              <h2 class="text-2xl">
                {s.title}
                {s.badge && (
                  <span class="ml-2 rounded-full bg-royal px-3 py-1 align-middle font-sans text-xs font-semibold text-white">
                    {s.badge}
                  </span>
                )}
              </h2>
              <p class="mt-1 text-muted">{s.summary}</p>
            </div>
            <p class="font-semibold text-ink md:text-right" set:html={ph(s.price)} />
          </a>
        ))
      }
    </div>
  </section>

  <section class="bg-white">
    <div class="wrap section grid gap-10 md:grid-cols-[1fr_1.4fr] md:gap-16">
      <div>
        <p class="eyebrow">What it costs</p>
        <h2 class="mt-3 text-3xl md:text-4xl">Price follows scope, so I quote once we've defined it.</h2>
        <p class="mt-4 text-muted">
          One service can cover a small job or a very large one, so I don't publish a single price for each. These are
          rough guides. Everything beyond a checkup is quoted as a fixed price once the scope is agreed. Prices exclude
          any applicable sales tax.
        </p>
      </div>
      <dl class="space-y-5">
        {
          costs.map((c) => (
            <div class="border-b border-line pb-5 last:border-0">
              <dt class="text-xl font-semibold text-ink">{c.t}</dt>
              <dd class="mt-1 text-muted">{c.d}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section>
    <div class="wrap section">
      <h2 class="text-3xl md:text-4xl">Questions</h2>
      <div class="mt-8 max-w-3xl">
        <FAQ items={faqs} />
      </div>
    </div>
  </section>
  <CTABand />
</BaseLayout>
