---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABand from '../components/CTABand.astro';
import Photo from '../components/Photo.astro';
import PageHero from '../components/PageHero.astro';

// Experience is described by area, without employer names or dates. Case studies stay anonymized to match.
const areas = [
  {
    title: 'Running a small business',
    text: 'Started and run a contracting and handyman company. Designed the processes and tools behind quoting, job checklists and bookkeeping, and cut the software bill by more than half.',
    tags: ['Process design', 'QuickBooks', 'Asana', 'AI-assisted quoting'],
  },
  {
    title: 'Industrial and machine-control software',
    text: 'The only engineer in the code on machine-control software for industrial equipment, integrating motion controllers, PLCs and sensors, plus a computer-vision tool.',
    tags: ['C#', 'WinForms and WPF', 'Modbus', 'Python', 'OpenCV'],
  },
  {
    title: 'Enterprise systems at scale',
    text: 'Lead engineer on enterprise software for federal and enterprise clients. Coordinated 15+ offshore engineers with code reviews and design guidance, and worked with project managers and security teams to deliver compliant systems.',
    tags: ['C#', 'SQL Server', 'Python', 'JavaScript', 'REST APIs'],
  },
  {
    title: 'Commerce and cloud platforms',
    text: 'Core engineer on a commerce platform connecting partner networks to suppliers, built as microservices. Set up development processes, managed Azure environments, significantly reduced cloud spend, and brought AI tooling into the development lifecycle.',
    tags: ['ASP.NET Core', 'Azure Functions', 'CI/CD', 'AI-assisted development'],
  },
  {
    title: 'Financial services automation',
    text: 'One of the first programmers hired during a migration to a new core banking platform. Replaced manual spreadsheet routines with one-screen forms, bulk-load scripts and system integrations.',
    tags: ['Automation', 'SQL', 'SOAP', 'C#'],
  },
  {
    title: 'Interactive and VR',
    text: 'Sole developer of a multiplayer VR training simulator, including complex hand interactions kept in sync across users. I’ve also released a VR title on the Meta Quest store and built games in game jams and on my own.',
    tags: ['Unity', 'C#', 'Photon Fusion', 'Meta Quest'],
  },
];

const certs = [
  ['Unity', 'Certified User: VR Developer; Certified User: Programmer'],
  ['Microsoft', 'Technology Associate'],
  ['CIW', 'Site Development Associate; Advanced HTML5 and CSS3 Specialist; User Interface Designer'],
  ['Oracle', 'Database SQL Certified Associate'],
  ['CompTIA', 'A+, Network+, Project+, Security+ (earned; no longer current)'],
];
---

<BaseLayout
  title="About Tyler Latimer"
  description="Oakheart Technologies is run by Tyler Latimer, a software engineer with 8+ years of experience who also owns a contracting and handyman business."
>
  <PageHero>
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr] md:items-start">
    <div>
      <p class="eyebrow">About</p>
      <h1 class="mt-3 text-4xl text-white md:text-6xl">An engineer who also runs a small business.</h1>
      <div class="prose-measure mt-8 space-y-5 text-lg text-[#d7deeb]">
        <p>
          I'm Tyler Latimer, a software engineer with more than eight years of experience in C# and .NET. I've built
          enterprise systems, commerce platforms and machine-control software, and I've taken over struggling software and
          turned it around.
        </p>
        <p>
          I also own TRL Home Solutions, a contracting and handyman company I started on my own and have grown to a
          working crew. That means I know the operational side of a small business firsthand: the quotes, the scheduling,
          the paperwork at 9 pm. It's why I talk about outcomes, not technology.
        </p>
        <p>
          I've also spent several years as the sole developer on a multiplayer VR training simulator, so I can build
          interactive and simulation software, not just business tools.
        </p>
      </div>
    </div>
    <div class="mx-auto flex w-full max-w-[14rem] flex-col gap-8 md:mx-0 md:max-w-[20rem] md:justify-self-end">
      <figure class="w-full max-w-[14rem]">
        <img
          src="/images/tyler-latimer.webp"
          alt="Tyler Latimer"
          width="448"
          height="448"
          class="aspect-square w-full rounded-2xl border border-white/15 object-cover shadow-lg"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption class="mt-3 text-sm text-[#aab6cc]">Tyler Latimer, founder. Spokane, WA.</figcaption>
      </figure>
      <figure>
        <Photo
          name="/images/office/tyler-at-desk-coding"
          alt="Tyler at his desk, working in Unity and Visual Studio across two monitors"
          widths={[400, 640, 1280]}
          width={1280}
          height={1828}
          sizes="(min-width: 768px) 20rem, 14rem"
          class="w-full rounded-2xl border border-white/15 shadow-lg"
          loading="eager"
        />
        <figcaption class="mt-3 text-sm text-[#aab6cc]">At work in the home office.</figcaption>
      </figure>
    </div>
    </div>
  </PageHero>

  <section class="bg-white">
    <div class="wrap section">
      <h2 class="text-3xl md:text-4xl">What I hold myself to</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {
          [
            ['Honesty over optimism', 'If something isn’t worth building, or is cheaper to rebuild, I’ll say so.'],
            ['Fixed prices where possible', 'You see the number before the work starts. Changes are agreed in writing.'],
            ['You own what you pay for', 'Code, accounts and documentation are handed over. No lock-in.'],
            ['Plain language', 'No jargon and no AI buzzwords. If I use a tool, I’ll tell you what it does.'],
          ].map(([t, d]) => (
            <div class="border-t-2 border-oak pt-4">
              <h3 class="text-xl">{t}</h3>
              <p class="mt-2 text-muted">{d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="wrap section">
      <h2 class="text-3xl md:text-4xl">How I use AI</h2>
      <div class="prose-measure mt-4 space-y-4">
        <p>
          I use AI tools every day, in my own business and in software development, because they save real time. I use
          them the way I would use any power tool: with judgment, and with a human checking the result.
        </p>
        <ul class="list-disc space-y-2 pl-5">
          <li>A person reviews anything that matters before it goes out. That person is me.</li>
          <li>Client names and private information stay out of the tools.</li>
          <li>I tell you where AI helps, where it does not, and when you don’t need it at all.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="wrap section">
      <p class="eyebrow">Experience</p>
      <h2 class="mt-3 text-3xl md:text-4xl">Where I've worked</h2>
      <p class="prose-measure mt-4 text-muted">
        More than eight years across industrial, enterprise, financial and commerce software, plus a small business of my
        own.
      </p>
      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          areas.map((a) => (
            <div class="card reveal flex flex-col p-6">
              <h3 class="text-xl">{a.title}</h3>
              <p class="mt-2 flex-1 text-muted">{a.text}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {a.tags.map((t) => (
                  <li class="rounded-full border border-line bg-paper px-3 py-1 text-xs font-medium text-ink">{t}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="wrap section grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-3xl md:text-4xl">Credentials</h2>
        <p class="mt-4 text-muted">B.S. Software Development, Western Governors University.</p>
        <ul class="mt-5 space-y-3">
          {
            certs.map(([org, list]) => (
              <li>
                <span class="font-semibold text-ink">{org}:</span> {list}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="text-3xl md:text-4xl">Why “Oakheart”</h2>
        <p class="prose-measure mt-4">
          Heartwood is the strongest, most durable part of an oak. The name is a promise: work that’s built strong and
          built to last.
        </p>
        <h2 class="mt-10 text-3xl md:text-4xl">Where I work</h2>
        <p class="prose-measure mt-4">
          Based in Spokane, WA. I meet local clients in person and work with clients anywhere, remotely. I’m also open
          to discussing travel to a customer in certain cases.
        </p>
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>
