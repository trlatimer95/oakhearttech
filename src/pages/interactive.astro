---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { site } from '../data/site';

const built = [
  {
    icon: 'headset',
    title: 'The Castle Experience',
    tag: 'Released on Meta Quest',
    text: 'A VR title live on the Meta Quest store. It started as a prototype and demo, and it taught me what it takes to take a VR project from idea to a published release.',
    href: 'https://www.meta.com/experiences/the-castle-experience/6122799184408683/',
    linkText: 'View on the Meta Quest store',
    external: true,
  },
  {
    icon: 'users',
    title: 'A multiplayer VR training simulator',
    tag: 'In development',
    text: 'A simulator that lets fire departments train together on real calls, even when crews are in different places. Built in Unity with Photon Fusion networking.',
    href: '/work/vr-ems-training/',
    linkText: 'Read the story',
  },
  {
    icon: 'code',
    title: 'Holdstrong: Castle Defender',
    tag: 'GameDev.tv game jam',
    text: 'A game built for a GameDev.tv game jam, where scope, design and polish all have to fit a short clock. Playable now.',
    href: 'https://trlatimer.itch.io/holdstrong-castle-defender',
    linkText: 'Play it on itch.io',
    external: true,
  },
  {
    icon: 'code',
    title: 'Mushroom Reborn',
    tag: 'GameDev.tv game jam',
    text: 'A second GameDev.tv game jam entry, built under the same tight deadline. Also playable now.',
    href: 'https://trlatimer.itch.io/mushroom-reborn',
    linkText: 'Play it on itch.io',
    external: true,
  },
];
---

<BaseLayout
  title="Games and VR"
  description="Games and VR from Oakheart Technologies: a released VR title on Meta Quest, a multiplayer VR training simulator, and game jam games."
>
  <section class="on-dark relative overflow-hidden bg-ink text-paper">
    <svg
      class="pointer-events-none absolute -right-48 -bottom-48 h-[46rem] w-[46rem] text-brass opacity-[0.08]"
      viewBox="0 0 200 200"
      fill="none"
      stroke="currentColor"
      stroke-width="1"
      aria-hidden="true"
    >
      {[16, 30, 44, 58, 72, 86, 100].map((r) => <circle cx="100" cy="100" r={r}></circle>)}
    </svg>
    <div class="wrap section relative grid gap-10 md:grid-cols-[1.2fr_1fr] md:items-center">
      <div>
        <Logo variant="emblem" tone="light" />
        <p class="eyebrow mt-8">Games and VR</p>
        <h1 class="mt-3 max-w-3xl text-4xl text-paper md:text-6xl">The games and simulation side of the studio.</h1>
        <p class="prose-measure mt-6 text-xl text-paper/80">
          The same engineering and the same standards as the business work, aimed at things that are fun to build.
        </p>
      </div>
      <Photo
        name="/images/office/tyler-vr-headset-hero"
        alt="Tyler reaching up to hang a Meta Quest headset on the rack above his desk"
        widths={[500, 1000, 2000]}
        width={2000}
        height={1567}
        sizes="(min-width: 768px) 40vw, 100vw"
        class="w-full rounded-2xl border border-white/10 shadow-lg"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <section>
    <div class="wrap section">
      <p class="eyebrow">What I've built</p>
      <h2 class="mt-3 max-w-2xl text-3xl md:text-4xl">From game jams to a published VR title.</h2>
      <p class="prose-measure mt-4 text-muted">
        I'm a Unity Certified User in both VR Development and Programming, and I've worked on interactive projects at
        every size, from a weekend game to a multi-year simulator. I also keep a bench of solo prototypes where I
        test mechanics, VR interactions and tools.
      </p>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {
          built.map((b) => (
            <div class="card reveal flex flex-col p-7">
              <div class="flex items-center justify-between gap-4">
                <span class="text-royal">
                  <Icon name={b.icon} class="h-8 w-8" />
                </span>
                <span class="rounded-full border border-line bg-paper px-3 py-1 text-xs font-semibold text-oak">
                  {b.tag}
                </span>
              </div>
              <h3 class="mt-4 text-2xl">{b.title}</h3>
              <p class="mt-2 flex-1 text-muted">{b.text}</p>
              {b.href && (
                <a
                  href={b.href}
                  target={b.external ? '_blank' : undefined}
                  rel={b.external ? 'noopener noreferrer' : undefined}
                  class="mt-4 font-semibold text-royal underline underline-offset-4"
                >
                  {b.linkText}
                  {b.external && <span class="sr-only"> (opens in a new tab)</span>}
                </a>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="wrap section grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-3xl md:text-4xl">What's next</h2>
        <div class="prose-measure mt-4 space-y-4">
          <p>
            Interactive work sits alongside the consulting. The training simulator is still in development, and I'm
            working on new game ideas that aren't ready to show yet. When there's something new to play, it'll be
            announced here.
          </p>
          <p>
            For business and organizational training, see
            <a class="font-semibold text-royal underline underline-offset-4" href="/services/interactive-vr/"
              >Interactive &amp; VR Training</a
            >.
          </p>
        </div>
      </div>
      <div class="card self-start p-7">
        <h2 class="text-2xl">Have something in mind?</h2>
        <p class="mt-2 text-muted">
          If you have a training simulation or an interactive idea you'd like built, or you just want to hear when the
          next game is ready, send me a note.
        </p>
        <Button href={`mailto:${site.email}?subject=Games%20and%20VR`} variant="secondary" class="mt-5">
          Get in touch
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
