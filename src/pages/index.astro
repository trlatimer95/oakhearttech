---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import CTABand from '../components/CTABand.astro';
import FAQ from '../components/FAQ.astro';
import SampleReport from '../components/SampleReport.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { services } from '../data/services';
import { bookingHref, bookingIsExternal } from '../data/site';
import { ph } from '../lib/ph';
import { originShort } from '../lib/origin';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);

// Each pain leads to the service that fixes it.
const pains = [
  { icon: 'copy', text: 'Typing the same data into three systems', href: '/services/automation-integrations/' },
  { icon: 'users', text: 'Using AI every day for jobs a simple tool would do more reliably', href: '/services/ai-implementation/' },
  { icon: 'gauge', text: 'Paying for several tools, with no clear picture of what’s used or what overlaps', href: '/services/software-cost-review/' },
  { icon: 'code', text: 'A one-off problem no off-the-shelf tool solves', href: '/services/custom-software/' },
  { icon: 'lifebuoy', text: 'A software project that stalled, was abandoned, or was built with AI and now breaks', href: '/services/software-rescue/' },
  { icon: 'globe', text: 'A website that’s slow, down or full of broken links', href: '/services/software-rescue/' },
];

// Figures come from the case studies. Keep them identical to what those pages say.
const proof = [
  { figure: '200+', label: 'defects fixed over my time on machine-control software, with new reports nearly stopping' },
  { figure: '10+ steps → 1', label: 'a weekly spreadsheet routine replaced with a one-screen form' },
  { figure: '$700 → $250', label: 'monthly software cost in my own business after consolidating overlapping tools' },
];

const checkup = [
  'A review of one business workflow and the tools behind it',
  'The most expensive or time-consuming bottlenecks, ranked',
  '3–5 prioritized fixes, each with cost, effort and time saved',
  'A written action plan you keep, whether or not you hire me',
];

const rank = [
  { t: 'Customer pain', d: 'What hurts the people who use it or pay for it, first. If they’re about to leave, it goes to the top.' },
  { t: 'Risk', d: 'Anything that can stop the business or lose data: failures, missing backups, single points of failure.' },
  { t: 'Efficiency', d: 'What wastes the most hours or money each week, and what can be removed rather than improved.' },
  { t: 'Everything else', d: 'Nice-to-haves wait. Fixing in small, verified steps beats a big risky change.' },
];

const steps = [
  { t: 'Listen', d: 'A free call to understand what’s broken and what it’s costing you.' },
  { t: 'Diagnose', d: 'The Workflow Checkup, or a code review for software: a written plan with priorities, costs and time saved.' },
  { t: 'Fix', d: 'Fixed-scope work with regular check-ins, so there are no surprises.' },
  { t: 'Hand off', d: 'Documentation, a walkthrough, and you own everything you paid for.' },
];

const why = [
  { t: 'Honest scope, fixed prices.', d: 'Clear estimates, changes agreed in writing, no surprise invoices.' },
  { t: 'You own it.', d: 'Code, accounts and documentation are handed over. No lock-in.' },
  { t: 'Small, verified steps.', d: 'I fix things in pieces I can check, and I tell you plainly when something isn’t worth fixing.' },
];

const faqs = [
  {
    q: 'What does a typical project cost?',
    a: 'It depends on scope, which is why I start with a fixed-price Workflow Checkup, $395, credited toward any project that follows. Larger work is quoted after the checkup, and my hourly rate for ad hoc work is $125.',
  },
  {
    q: 'Do you work with businesses outside Spokane?',
    a: 'Yes. Most work is done remotely, with video calls and shared documents. I’m happy to meet in person around Spokane, and I’m open to discussing travel to a customer in certain cases.',
  },
  {
    q: 'Who owns the software you build?',
    a: 'You do, once you’ve paid. I keep my own reusable tools and grant you a license to use them in your project.',
  },
  {
    q: 'I already pay for software. Can you make it work better instead of replacing it?',
    a: 'Usually, yes. Connecting and configuring what you already have is often the cheapest fix.',
  },
  {
    q: 'What if my last developer disappeared?',
    a: 'That’s exactly what Software Rescue is for. The first step is making sure you have access to your code and accounts.',
  },
  {
    q: 'Do you charge sales tax?',
    a: 'It depends on the state. Washington recently began treating technology services as taxable, so Washington clients are charged sales tax, itemized on every quote. Clients elsewhere are taxed according to their own state’s rules, and I’ll confirm what applies when I quote.',
  },
];
---

<BaseLayout
  fullTitle
  title="Oakheart Technologies: Fix Broken Software & Processes"
  description="I fix broken software and manual processes for small businesses: rescue, automation, cost reviews and custom software. Spokane, WA and remote."
>
  <!-- 1. Hero -->
  <section class="relative overflow-hidden">
    <svg
      class="pointer-events-none absolute -top-40 -right-40 h-[44rem] w-[44rem] text-oak opacity-[0.06]"
      viewBox="0 0 200 200"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
      aria-hidden="true"
    >
      {[18, 32, 46, 60, 74, 88].map((r) => <circle cx="100" cy="100" r={r}></circle>)}
    </svg>
    <div class="wrap relative section">
      <p class="eyebrow">Software for small business, from someone who runs one</p>
      <h1 class="mt-4 max-w-4xl text-[2.5rem] leading-[1.08] md:text-7xl">
        I fix what's broken and make the rest run better.
      </h1>
      <p class="prose-measure mt-6 text-xl text-muted">
        Failing software, manual processes and runaway costs: diagnosed, fixed and handed over with documentation. Based
        in Spokane, working locally and remotely.
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <Button href={bookingHref} external={bookingIsExternal}>Book a free 30-minute call</Button>
        <Button href="/work/" variant="secondary">See the results</Button>
      </div>
      <dl class="mt-12 grid gap-6 border-t border-line pt-8 sm:grid-cols-3">
        {
          proof.map((p) => (
            <div>
              <dt class="font-serif text-3xl font-semibold text-royal md:text-4xl">{p.figure}</dt>
              <dd class="mt-1 text-sm text-muted">{p.label}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-8 text-sm font-medium text-muted">
        Software engineer · Owner of TRL Home Solutions · Based in Spokane, WA · Working locally and remotely
      </p>
    </div>
  </section>

  <!-- 2. What's broken -->
  <section class="bg-white">
    <div class="wrap section">
      <p class="eyebrow">What's broken?</p>
      <h2 class="mt-3 max-w-2xl text-3xl md:text-4xl">The problems I'm usually called in to fix.</h2>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          pains.map((p) => (
            <li class="reveal">
              <a
                href={p.href}
                class="group flex h-full items-start gap-4 rounded-xl border border-line bg-paper p-5 transition-colors hover:border-royal"
              >
                <span class="text-royal">
                  <Icon name={p.icon} />
                </span>
                <span>
                  <span class="block font-medium text-ink">{p.text}</span>
                  <span class="mt-2 flex items-center gap-1 text-sm font-semibold text-royal group-hover:gap-2">
                    See how I fix this <Icon name="arrow" class="h-4 w-4" />
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. Services -->
  <section>
    <div class="wrap section">
      <p class="eyebrow">Services</p>
      <h2 class="mt-3 max-w-2xl text-3xl md:text-4xl">Tell me what's broken. I'll tell you what it takes to fix it.</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          services.filter((s) => s.slug !== 'interactive-vr').map((s) => (
            <a href={`/services/${s.slug}/`} class="card reveal group relative block p-7 transition-shadow hover:shadow-lg">
              {s.badge && (
                <span class="absolute top-5 right-5 rounded-full bg-royal px-3 py-1 text-xs font-semibold text-white">
                  {s.badge}
                </span>
              )}
              <span class="text-royal">
                <Icon name={s.icon} class="h-8 w-8" />
              </span>
              <h3 class="mt-4 text-2xl">{s.title}</h3>
              <p class="mt-2 text-muted">{s.summary}</p>
              <p class="mt-5 font-semibold text-ink" set:html={ph(s.price)} />
              <span class="mt-2 flex items-center gap-1 font-semibold text-royal group-hover:gap-2">
                Learn more <Icon name="arrow" class="h-4 w-4" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Entry offer -->
  <section class="bg-white">
    <div class="wrap section grid gap-10 md:grid-cols-[1.2fr_1fr] md:items-start md:gap-16">
      <div>
        <p class="eyebrow">Start here</p>
        <h2 class="mt-3 text-3xl md:text-4xl">Start with a Workflow Checkup.</h2>
        <p class="mt-4 text-muted">
          Not sure what to fix first? In one working session and a short written report, you find out where the time and
          money are going and what to do about it, before you commit to anything bigger.
        </p>
        <ul class="mt-6 space-y-3">
          {
            checkup.map((c) => (
              <li class="flex gap-3">
                <span class="mt-0.5 text-royal">
                  <Icon name="check" />
                </span>
                <span>{c}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button href={bookingHref} external={bookingIsExternal}>Book a free 30-minute call</Button>
          <Button href="/services/workflow-checkup/" variant="secondary">See what's included</Button>
        </div>
      </div>
      <aside class="card p-7">
        <p class="font-serif text-5xl font-semibold text-ink">$395</p>
        <p class="mt-1 font-semibold text-oak">Fixed price, credited toward any project that follows</p>
        <dl class="mt-6 space-y-4 text-sm">
          <div>
            <dt class="font-semibold text-ink">Scope</dt>
            <dd class="mt-0.5 text-muted">
              One workflow and up to about five tools or systems, with a 60–90 minute working session.
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">Turnaround</dt>
            <dd class="mt-0.5 text-muted">Written report within 3 business days of the session.</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">Bigger than that?</dt>
            <dd class="mt-0.5 text-muted">
              A review across a whole company is quoted separately. I'll tell you on the free call.
            </dd>
          </div>
        </dl>
      </aside>
    </div>
    <div class="wrap pb-16 md:pb-24">
      <SampleReport />
    </div>
  </section>

  <!-- 5. Featured work -->
  {
    work.length > 0 && (
      <section>
        <div class="wrap section">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="eyebrow">Featured work</p>
              <h2 class="mt-3 text-3xl md:text-4xl">Problem, fix, result.</h2>
            </div>
            <a href="/work/" class="inline-flex min-h-11 items-center font-semibold text-royal underline underline-offset-4">All work</a>
          </div>
          <div class="mt-10">
            <p class="font-semibold text-ink">
              One example: a weekly routine cut from 10+ steps to one screen.
              <a href="/work/credit-union-workflows/" class="ml-1 text-royal underline underline-offset-4">Read the story</a>
            </p>
            <BeforeAfter />
          </div>
          <div class="grid gap-6 md:grid-cols-3">
            {work.map((w) => (
              <a href={`/work/${w.id}/`} class="card reveal block p-6 transition-shadow hover:shadow-lg">
                {w.data.draft && <span class="ph text-xs font-semibold">DRAFT PLACEHOLDER</span>}
                <p class="eyebrow mt-3">{originShort[w.data.origin]} · {w.data.service}</p>
                <h3 class="mt-2 text-xl">{w.data.title}</h3>
                <p class="mt-2 text-muted">{w.data.summary}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 6. Founder and trust -->
  <section class="bg-white">
    <div class="wrap section grid gap-10 md:grid-cols-[auto_1fr] md:gap-14">
      <figure class="mx-auto w-full max-w-[12rem] md:mx-0">
        <img
          src="/images/tyler-latimer.webp"
          alt="Tyler Latimer"
          width="448"
          height="448"
          loading="lazy"
          class="aspect-square w-full rounded-2xl border border-line object-cover shadow-sm"
        />
        <figcaption class="mt-3 text-sm text-muted">Tyler Latimer, founder</figcaption>
      </figure>
      <div>
        <p class="eyebrow">Who you'd work with</p>
        <h2 class="mt-3 max-w-2xl text-3xl md:text-4xl">Software engineer. Small business owner.</h2>
        <div class="prose-measure mt-4 space-y-3 text-lg text-muted">
          <p>I'm Tyler, a software engineer with more than eight years of experience building, fixing and improving software.</p>
          <p>I also own a contracting company, so I've felt firsthand how much time a business loses to clumsy tools and manual work.</p>
          <p>Oakheart brings those two sides together: engineering skill, and an owner's sense of what actually matters.</p>
        </div>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {
            why.map((w) => (
              <div class="reveal border-t-2 border-oak pt-5">
                <h3 class="text-xl">{w.t}</h3>
                <p class="mt-2 text-muted">{w.d}</p>
              </div>
            ))
          }
        </div>
        <p class="mt-8"><a href="/about/" class="font-semibold text-royal underline underline-offset-4">More about me</a></p>
      </div>
    </div>
  </section>

  <!-- 7. How I work -->
  <section>
    <div class="wrap section">
      <p class="eyebrow">How I work</p>
      <h2 class="mt-3 max-w-2xl text-3xl md:text-4xl">Listen. Diagnose. Fix. Hand off.</h2>
      <ol class="mt-10 grid gap-6 md:grid-cols-4">
        {
          steps.map((s, i) => (
            <li class="reveal">
              <span class="font-serif text-4xl font-semibold text-oak">{i + 1}</span>
              <h3 class="mt-2 text-xl">{s.t}</h3>
              <p class="mt-2 text-muted">{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 8. How I diagnose -->
  <section class="bg-white">
    <div class="wrap section grid gap-10 md:grid-cols-[1fr_1.4fr] md:gap-16">
      <div>
        <p class="eyebrow">How I diagnose</p>
        <h2 class="mt-3 text-3xl md:text-4xl">Rank by what costs you most, then work down.</h2>
        <p class="mt-4 text-muted">
          When there's a long list of problems, the answer is rarely to start over. I rank every issue by its cost to you
          and fix them in that order, in small steps that I verify as I go.
        </p>
      </div>
      <ol class="space-y-5">
        {
          rank.map((r, i) => (
            <li class="reveal flex gap-4 border-b border-line pb-5 last:border-0">
              <span class="font-serif text-3xl font-semibold text-oak">{i + 1}</span>
              <div>
                <h3 class="text-xl">{r.t}</h3>
                <p class="mt-1 text-muted">{r.d}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 9. Interactive & VR strip (secondary) -->
  <section class="on-dark bg-ink text-paper">
    <div class="wrap flex flex-col gap-6 py-14 md:flex-row md:items-center md:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow">Beyond business software</p>
        <h2 class="mt-3 text-2xl text-paper md:text-3xl">Interactive training and simulation.</h2>
        <p class="mt-3 text-paper/80">
          I also build interactive and VR training, including a multiplayer simulator for fire departments. I've released
          a VR title on the Meta Quest store, and I'm developing games under Oakheart Interactive.
        </p>
      </div>
      <div class="flex flex-wrap gap-4">
        <Button href="/services/interactive-vr/" variant="light">Interactive & VR training</Button>
        <Button href="/interactive/" variant="outline-light">Oakheart Interactive</Button>
      </div>
    </div>
  </section>

  <!-- 10. FAQ -->
  <section>
    <div class="wrap section">
      <p class="eyebrow">FAQ</p>
      <h2 class="mt-3 text-3xl md:text-4xl">Common questions</h2>
      <div class="mt-8 max-w-4xl">
        <FAQ items={faqs} />
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>
