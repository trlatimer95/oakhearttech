---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import CTABand from '../../components/CTABand.astro';
import FAQ from '../../components/FAQ.astro';
import SampleReport from '../../components/SampleReport.astro';
import Photo from '../../components/Photo.astro';
import PageHero from '../../components/PageHero.astro';
import CheckupBoard from '../../components/CheckupBoard.astro';
import { services, type Service } from '../../data/services';
import { bookingHref, bookingIsExternal } from '../../data/site';
import { ph } from '../../lib/ph';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const service = Astro.props.s as Service;
---

<BaseLayout title={service.seoTitle} description={service.metaDescription}>
  <!-- 1. Hero -->
  <PageHero>
    <a href="/services/" class="inline-flex min-h-11 items-center text-sm font-semibold text-brass underline underline-offset-4"
      >← All services</a
    >
    <div class:list={['mt-6', service.heroImage && 'grid gap-10 md:grid-cols-[1.3fr_1fr] md:items-center']}>
      <div>
        <p class="eyebrow">{service.title}{service.badge ? ` · ${service.badge}` : ''}</p>
        <h1 class="mt-3 max-w-4xl text-4xl text-white md:text-6xl">{service.heroTitle}</h1>
        <p class="prose-measure mt-6 text-xl text-[#b8c1d4]">{service.heroLead}</p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <Button href={bookingHref} external={bookingIsExternal} variant="brass">Book a free 30-minute call</Button>
          <span class="font-semibold text-white" set:html={ph(service.price)} />
        </div>
      </div>
      {
        service.heroImage && (
          <Photo
            {...service.heroImage}
            sizes="(min-width: 768px) 40vw, 100vw"
            class="mx-auto w-full max-w-sm rounded-2xl border border-white/15 object-cover shadow-lg md:max-w-none"
            loading="eager"
            fetchpriority="high"
          />
        )
      }
    </div>
  </PageHero>

  <!-- 2. Signs -->
  <section class="bg-white">
    <div class="wrap section">
      <h2 class="text-3xl md:text-4xl">{service.signsTitle}</h2>
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {
          service.signs.map((t) => (
            <li class="flex gap-3 rounded-xl border border-line bg-paper p-5">
              <span class="mt-0.5 text-oak">
                <Icon name="check" />
              </span>
              <span>{t}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    service.focus && (
      <section>
        <div class="wrap section">
          <h2 class="text-3xl md:text-4xl">{service.focus.title}</h2>
          <p class="prose-measure mt-4 text-muted">{service.focus.intro}</p>
          <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {service.focus.items.map((f) => (
              <div class="card p-6">
                <h3 class="text-xl">{f.t}</h3>
                <p class="mt-2 text-muted">{f.d}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 3. Included -->
  <section>
    <div class="wrap section grid gap-10 md:grid-cols-[1fr_1fr]">
      <div>
        <h2 class="text-3xl md:text-4xl">{service.includesTitle}</h2>
        <ul class="mt-8 space-y-4">
          {
            service.includes.map((t) => (
              <li class="flex gap-3">
                <span class="mt-0.5 text-royal">
                  <Icon name="check" />
                </span>
                <span>{t}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <aside class="card self-start p-7">
        <p class="eyebrow">Price</p>
        <p class="mt-2 font-serif text-3xl font-semibold text-ink" set:html={ph(service.price)} />
        <p class="mt-3 text-muted" set:html={ph(service.priceNote)} />
        <Button href={bookingHref} external={bookingIsExternal} class="mt-6 w-full">Book a free call</Button>
      </aside>
    </div>
  </section>

  {
    service.slug === 'workflow-checkup' && (
      <div class="wrap pb-16 md:pb-24">
        <SampleReport />
      </div>
    )
  }

  {
    service.websites && (
      <section id="websites" class="scroll-mt-24">
        <div class="wrap pb-16 md:pb-24">
          <div class="card p-7 md:p-10">
            <h2 class="text-3xl md:text-4xl">{service.websites.title}</h2>
            <p class="prose-measure mt-4 text-muted">{service.websites.text}</p>
            <ul class="mt-6 grid gap-3 md:grid-cols-2">
              {service.websites.items.map((t) => (
                <li class="flex gap-3">
                  <span class="mt-0.5 text-royal">
                    <Icon name="check" />
                  </span>
                  <span>{t}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  {
    service.figures && (
      <div class="wrap pb-16 md:pb-24">
        <div class:list={['grid gap-8', service.figures.length > 1 ? 'md:grid-cols-2' : 'mx-auto max-w-3xl']}>
          {service.figures.map((f) => (
            <figure>
              <Photo {...f} sizes={service.figures!.length > 1 ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 48rem, 100vw'} class="w-full rounded-xl border border-line shadow-sm" />
              {f.caption && <figcaption class="mt-3 text-sm text-muted">{f.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </div>
    )
  }

  <!-- 4. Process, on the blueprint -->
  <section class="on-dark blueprint">
    <div class="wrap relative py-16 md:py-24">
      <p class="bp-label">// how it works</p>
      <h2 class="mt-3 text-3xl text-white md:text-4xl">{service.processTitle}</h2>
      {
        service.board && (
          <div class="mt-9">
            <CheckupBoard label="a real Checkup board, for a sample business ↓" />
          </div>
        )
      }
      <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-[repeat(auto-fit,minmax(11rem,1fr))]">
        {
          service.process.map((p, i) => (
            <li class="border-t-[1.5px] border-dashed border-[#4a5b85] pt-4">
              <span class="font-hand text-3xl leading-none text-brass">0{i + 1}</span>
              <h3 class="mt-3 text-xl text-white">{p.title}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-[#aab6cc]" set:html={ph(p.text)} />
            </li>
          ))
        }
      </ol>
      {
        service.stance && (
          <p class="mt-12 max-w-3xl border-l-4 border-brass bg-[#08101f]/60 p-5 font-serif text-xl text-[#e9edf5]">
            {service.stance}
          </p>
        )
      }
    </div>
  </section>

  <!-- 5. FAQ -->
  <section>
    <div class="wrap section">
      <h2 class="text-3xl md:text-4xl">Questions</h2>
      <div class="mt-8 max-w-3xl">
        <FAQ items={service.faqs} />
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>
