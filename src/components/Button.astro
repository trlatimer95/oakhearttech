---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'light' | 'outline-light';
  class?: string;
  external?: boolean;
}
const { href, variant = 'primary', class: cls = '', external = false } = Astro.props;
const styles = {
  primary: 'bg-royal text-white border-royal hover:bg-royal-dark hover:border-royal-dark',
  secondary: 'bg-transparent text-royal border-royal hover:bg-royal hover:text-white',
  light: 'bg-paper text-ink border-paper hover:bg-white',
  'outline-light': 'bg-transparent text-paper border-paper/60 hover:border-paper hover:bg-white/10',
};
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class:list={[
    'inline-flex items-center justify-center rounded-lg border-2 px-5 py-3 text-base font-semibold transition-colors duration-200',
    styles[variant],
    cls,
  ]}
>
  <slot />
</a>
