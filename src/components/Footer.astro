---
import Logo from './Logo.astro';
import { site } from '../data/site';
import { services } from '../data/services';
const year = new Date().getFullYear();
---

<footer class="on-dark night">
  <div class="wrap grid gap-10 py-14 md:grid-cols-4">
    <div class="md:col-span-2">
      <Logo tone="light" />
      <p class="mt-4 max-w-sm text-paper/80">
        Careful engineering.<br />Efficient processes.<br />Problems solved at the source.
      </p>
      <p class="mt-4 text-paper/80">
        <a class="underline decoration-brass underline-offset-4 hover:text-white" href={`mailto:${site.email}`}
          >{site.email}</a
        >
        {
          site.phone && (
            <span>
              {' · '}
              <a class="underline decoration-brass underline-offset-4 hover:text-white" href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}>
                {site.phone}
              </a>
            </span>
          )
        }
      </p>
      <p class="mt-1 text-paper/80">Based in Spokane, WA. Working with clients locally and remotely.</p>
    </div>

    <div>
      <h2 class="font-sans text-sm font-semibold tracking-widest text-brass uppercase">Services</h2>
      <ul class="mt-4 space-y-2">
        {
          services.map((s) => (
            <li>
              <a class="text-paper/80 hover:text-white" href={`/services/${s.slug}/`}>
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="font-sans text-sm font-semibold tracking-widest text-brass uppercase">Company</h2>
      <ul class="mt-4 space-y-2">
        <li><a class="text-paper/80 hover:text-white" href="/about/">About</a></li>
        <li><a class="text-paper/80 hover:text-white" href="/work/">Work</a></li>
        <li><a class="text-paper/80 hover:text-white" href="/interactive/">Games &amp; VR</a></li>
        <li><a class="text-paper/80 hover:text-white" href="/contact/">Contact</a></li>
        {site.linkedin && <li><a class="text-paper/80 hover:text-white" href={site.linkedin}>LinkedIn</a></li>}
        {site.github && <li><a class="text-paper/80 hover:text-white" href={site.github}>GitHub</a></li>}
        {site.facebook && <li><a class="text-paper/80 hover:text-white" href={site.facebook}>Facebook</a></li>}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="wrap flex flex-col gap-2 py-5 text-sm text-paper/70 sm:flex-row sm:justify-between">
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <p class="flex gap-2">
        <a class="inline-flex min-h-11 items-center px-3 first:pl-0 hover:text-white" href="/privacy/">Privacy</a>
        <a class="inline-flex min-h-11 items-center px-3 last:pr-0 hover:text-white" href="/terms/">Terms</a>
      </p>
    </div>
  </div>
</footer>
