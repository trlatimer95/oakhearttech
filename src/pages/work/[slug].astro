---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABand from '../../components/CTABand.astro';
import PageHero from '../../components/PageHero.astro';
import { ph } from '../../lib/ph';
import { originLong } from '../../lib/origin';
import BeforeAfter from '../../components/BeforeAfter.astro';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const blocks = [
  { label: 'Problem', text: d.problem },
  { label: 'Fix', text: d.fix },
  { label: 'Result', text: d.result },
];
---

<BaseLayout title={d.seoTitle ?? d.title} description={d.seoDescription ?? d.summary}>
  <PageHero>
    <a href="/work/" class="inline-flex min-h-11 items-center text-sm font-semibold text-brass underline underline-offset-4">← All work</a>
    {d.draft && <p class="ph mt-6 inline-block text-sm font-semibold">DRAFT PLACEHOLDER: not real content yet</p>}
    <p class="eyebrow mt-4">{d.client} · {d.service}</p>
    <h1 class="mt-3 max-w-4xl text-4xl text-white md:text-5xl">{d.title}</h1>
    <p class="mt-4 inline-block rounded-lg border border-white/15 bg-white/5 px-4 py-2 text-sm text-[#b8c1d4]">
      {originLong[d.origin]}
    </p>
  </PageHero>

  <section class="on-dark blueprint">
    <div class="wrap relative py-14 md:py-20">
      <p class="bp-label">// problem · fix · result</p>
      <div class="mt-6 grid gap-8 md:grid-cols-3">
        {
          blocks.map((b, i) => (
            <div class="border-t-[1.5px] border-dashed border-[#4a5b85] pt-4">
              <p class="font-hand text-3xl leading-none text-brass">0{i + 1}</p>
              <p class="eyebrow mt-3">{b.label}</p>
              <p class="mt-2 leading-relaxed text-[#e9edf5]" set:html={ph(b.text)} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <article class="wrap section">
    {entry.id === 'credit-union-workflows' && <div class="mb-12"><BeforeAfter /></div>}

    <div class="prose-measure space-y-4 [&_h2]:mt-8 [&_h2]:text-2xl">
      <Content />
    </div>
  </article>
  <CTABand />
</BaseLayout>
