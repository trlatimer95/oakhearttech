---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import CTABand from '../components/CTABand.astro';
import FAQ from '../components/FAQ.astro';
import { bookingHref, bookingIsExternal } from '../data/site';

// Prices are $125/hour x included hours. Update here when the rate changes.
const tiers = [
  {
    name: 'Watch',
    price: '$375',
    hours: '3 hours a month',
    blurb: 'For a stable system that just needs someone watching it.',
    items: ['Monitoring and uptime checks', 'Bug fixes and small changes', 'Replies within 1 business day'],
  },
  {
    name: 'Maintain',
    price: '$750',
    hours: '6 hours a month',
    blurb: 'For systems your business runs on every day.',
    items: [
      'Everything in Watch',
      'Dependency and platform updates',
      'A monthly check-in call and short report',
    ],
    featured: true,
  },
  {
    name: 'Partner',
    price: '$1,500',
    hours: '12 hours a month',
    blurb: 'For systems that keep changing as your business does.',
    items: [
      'Everything in Maintain',
      'Room for improvements, not just fixes',
      'First call on my schedule',
    ],
  },
];

const faqs = [
  {
    q: 'What happens to unused hours?',
    a: 'They do not roll over, so the monthly cost stays predictable. If you regularly use fewer hours than your plan includes, I will tell you and suggest a smaller one.',
  },
  {
    q: 'What if I need more than my plan includes?',
    a: 'Extra hours are $125 an hour, with your approval first. Larger changes are quoted as a fixed price.',
  },
  {
    q: 'Does this cover systems you did not build?',
    a: 'Only after I have reviewed them, so I know what I am taking responsibility for. A Project Rescue assessment is the usual way to do that.',
  },
  {
    q: 'Is there a contract?',
    a: 'A short written agreement with a 3-month minimum, then month to month. Either side can end it with 30 days notice, and you keep everything I have built.',
  },
  {
    q: 'Is this emergency support?',
    a: 'No. It is business-day support, with a reply within one business day. If you need round-the-clock cover, I will say so and point you to someone who offers it.',
  },
];
---

<BaseLayout
  title="Care Plans"
  description="Keep it fixed: monthly care plans that cover monitoring, fixes and small changes for the software and automations I build or review."
>
  <section class="wrap section">
    <p class="eyebrow">Care plans</p>
    <h1 class="mt-3 max-w-3xl text-4xl md:text-6xl">Fixed it once. Keep it fixed.</h1>
    <p class="prose-measure mt-6 text-xl text-muted">
      Software and automations need upkeep: updates, small changes, and someone who knows how it works when something
      goes wrong. A care plan is a fixed monthly fee for exactly that, so there is no scramble and no surprise bill.
    </p>
  </section>

  <section class="bg-white">
    <div class="wrap section">
      <div class="grid gap-6 md:grid-cols-3">
        {
          tiers.map((t) => (
            <div
              class:list={[
                'card relative flex flex-col p-7',
                t.featured && 'border-royal ring-2 ring-royal',
              ]}
            >
              {t.featured && (
                <span class="absolute top-5 right-5 rounded-full bg-royal px-3 py-1 text-xs font-semibold text-white">
                  Most common
                </span>
              )}
              <h2 class="text-2xl">{t.name}</h2>
              <p class="mt-1 text-muted">{t.blurb}</p>
              <p class="mt-5 font-serif text-4xl font-semibold text-ink">
                {t.price}<span class="font-sans text-base font-normal text-muted"> / month</span>
              </p>
              <p class="mt-1 text-sm font-semibold text-oak">{t.hours}</p>
              <ul class="mt-6 flex-1 space-y-3">
                {t.items.map((i) => (
                  <li class="flex gap-3">
                    <span class="mt-0.5 text-royal">
                      <Icon name="check" />
                    </span>
                    <span>{i}</span>
                  </li>
                ))}
              </ul>
              <Button href={bookingHref} external={bookingIsExternal} variant={t.featured ? 'primary' : 'secondary'} class="mt-7 w-full">
                Ask about {t.name}
              </Button>
            </div>
          ))
        }
      </div>
      <p class="mt-6 text-sm text-muted">
        Prices exclude applicable Washington sales tax. Plans start after a project is delivered or a system is reviewed.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap section grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-3xl md:text-4xl">What a plan covers, and what it does not</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          <div>
            <h3 class="text-xl">Covered</h3>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-muted">
              <li>Fixing bugs in what I built or reviewed</li>
              <li>Small changes and tweaks</li>
              <li>Keeping software up to date</li>
              <li>Answering "why did it do that?"</li>
            </ul>
          </div>
          <div>
            <h3 class="text-xl">Not covered</h3>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-muted">
              <li>New features beyond your included hours (quoted separately)</li>
              <li>Outages at third-party services</li>
              <li>Systems I have not reviewed</li>
              <li>Round-the-clock emergency response</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="card self-start p-7">
        <p class="eyebrow">Need more than a plan?</p>
        <h2 class="mt-2 text-2xl">Fractional engineering lead</h2>
        <p class="mt-3 text-muted">
          For companies with real software and no senior engineer: technical direction, review of developers' and
          contractors' work, planning and hands-on fixes, about 20 hours a month.
        </p>
        <p class="mt-4 font-serif text-3xl font-semibold text-ink">
          $2,500<span class="font-sans text-base font-normal text-muted"> / month</span>
        </p>
        <p class="mt-1 text-sm text-muted">Offered selectively. Start with a free call.</p>
        <Button href={bookingHref} external={bookingIsExternal} variant="secondary" class="mt-5">Talk it through</Button>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="wrap section">
      <h2 class="text-3xl md:text-4xl">Questions</h2>
      <div class="mt-8 max-w-3xl">
        <FAQ items={faqs} />
      </div>
    </div>
  </section>

  <CTABand
    title="Want it to stay fixed?"
    text="Tell me what you run today and I will say which plan, if any, makes sense."
  />
</BaseLayout>
