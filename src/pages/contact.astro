---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contact"
  description="Book a free 30-minute call or send a message. Oakheart Technologies, based in Spokane, WA and working with clients remotely."
>
  <section class="wrap section">
    <p class="eyebrow">Contact</p>
    <h1 class="mt-3 max-w-3xl text-4xl md:text-6xl">Let’s talk about what’s slowing you down.</h1>
    <p class="prose-measure mt-6 text-xl text-muted">
      I reply within 1 business day. Email: <a class="font-semibold text-royal underline underline-offset-4" href={`mailto:${site.email}`}>{site.email}</a>
    </p>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <!-- Booking -->
      <div id="book" class="card scroll-mt-24 p-7">
        <h2 class="text-2xl">Book a free 30-minute call</h2>
        {
          site.bookingUrl ? (
            <>
              <p class="mt-2 text-muted">
                Bring one frustrating process, recurring software expense or broken system. We'll talk through what's
                happening, what you've tried, and whether I can help. No sales pitch.
              </p>
              <p class="mt-2 text-muted">Pick a time that works, and you'll get a calendar invite with a video link.</p>
              <Button href={site.bookingUrl} external class="mt-6">Choose a time</Button>
            </>
          ) : (
            <p class="mt-3">
              <span class="ph">[Booking link not set up yet. Add the Microsoft Bookings URL to src/data/site.ts.]</span>
              Until then, email me and we will find a time.
            </p>
          )
        }
      </div>

      <!-- Form -->
      <form id="contact-form" class="card space-y-5 p-7" data-access-key={site.web3formsAccessKey}>
        <h2 class="text-2xl">Or send a message</h2>
        {
          [
            { id: 'name', label: 'Name', type: 'text', required: true, auto: 'name' },
            { id: 'business', label: 'Business', type: 'text', required: false, auto: 'organization' },
            { id: 'email', label: 'Email', type: 'email', required: true, auto: 'email' },
            { id: 'phone', label: 'Phone (optional)', type: 'tel', required: false, auto: 'tel' },
          ].map((f) => (
            <div>
              <label for={f.id} class="block text-sm font-semibold text-ink">
                {f.label}
              </label>
              <input
                id={f.id}
                name={f.id}
                type={f.type}
                required={f.required}
                autocomplete={f.auto}
                class="mt-1 w-full rounded-lg border border-line bg-paper px-3 py-2.5 text-base"
              />
            </div>
          ))
        }
        <div>
          <label for="message" class="block text-sm font-semibold text-ink">What’s slowing you down?</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="mt-1 w-full rounded-lg border border-line bg-paper px-3 py-2.5 text-base"></textarea>
        </div>
        <div>
          <label for="source" class="block text-sm font-semibold text-ink">How did you hear about Oakheart?</label>
          <input id="source" name="source" type="text" class="mt-1 w-full rounded-lg border border-line bg-paper px-3 py-2.5 text-base" />
        </div>
        <!-- Honeypot (Web3Forms "botcheck"): real people leave this empty -->
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <!-- hCaptcha, injected by the Web3Forms client script. Enabled in the Web3Forms dashboard. -->
        <div class="h-captcha" data-captcha="true"></div>
        <button
          type="submit"
          class="rounded-lg border-2 border-royal bg-royal px-5 py-3 text-base font-semibold text-white hover:bg-royal-dark"
        >
          Send message
        </button>
        <p id="form-status" role="status" class="text-sm font-medium"></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Load the captcha only when someone starts using the form. That keeps third-party cookies and scripts off the page
  // until they're needed, which is better for privacy and for page speed.
  (function () {
    var form = document.getElementById('contact-form');
    if (!form) return;
    var loaded = false;
    function load() {
      if (loaded) return;
      loaded = true;
      var s = document.createElement('script');
      s.src = 'https://web3forms.com/client/script.js';
      s.async = true;
      s.defer = true;
      document.body.appendChild(s);
    }
    ['focusin', 'pointerdown', 'keydown', 'touchstart'].forEach(function (e) {
      form.addEventListener(e, load, { once: true, passive: true });
    });
  })();
</script>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;
    const key = form.dataset.accessKey;
    if (!key) {
      status.textContent = 'The form isn’t set up yet. Please email me directly instead.';
      return;
    }
    const captcha = form.querySelector('textarea[name="h-captcha-response"]') as HTMLTextAreaElement | null;
    if (captcha && !captcha.value) {
      status.textContent = 'Please complete the captcha above, then send again.';
      return;
    }
    status.textContent = 'Sending…';
    try {
      const data = new FormData(form);
      data.append('access_key', key);
      data.append('subject', 'New website inquiry: Oakheart Technologies');
      data.append('from_name', 'Oakheart website');
      const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: data });
      const result = await res.json();
      if (!result.success) throw new Error('rejected');
      form.reset();
      status.textContent = 'Thanks, message sent. I’ll reply within 1 business day.';
    } catch {
      status.textContent = 'Something went wrong. Please email me directly instead.';
    }
  });
</script>
