---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABand from '../../components/CTABand.astro';
import { ph } from '../../lib/ph';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const blocks = [
  { label: 'Problem', text: d.problem },
  { label: 'Fix', text: d.fix },
  { label: 'Result', text: d.result },
];
---

<BaseLayout title={d.title} description={d.summary}>
  <article class="wrap section">
    <a href="/work" class="text-sm font-semibold text-royal underline underline-offset-4">← All work</a>
    {d.draft && <p class="ph mt-6 inline-block text-sm font-semibold">DRAFT PLACEHOLDER: not real content yet</p>}
    <p class="eyebrow mt-4">{d.client} · {d.service}</p>
    <h1 class="mt-3 max-w-4xl text-4xl md:text-5xl">{d.title}</h1>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        blocks.map((b) => (
          <div class="card p-6">
            <p class="eyebrow">{b.label}</p>
            <p class="mt-2" set:html={ph(b.text)} />
          </div>
        ))
      }
    </div>

    <div class="prose-measure mt-12 space-y-4 [&_h2]:mt-8 [&_h2]:text-2xl">
      <Content />
    </div>
  </article>
  <CTABand />
</BaseLayout>
